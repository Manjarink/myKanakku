# Server Configuration
PORT=5001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase Credentials
# Backend requires SUPABASE_SERVICE_ROLE_KEY to bypass RLS for server operations
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL Database URL (for migrations and direct connections)
DATABASE_URL=postgresql://postgres:password@localhost:5432/mykanakku

# Google Gemini AI Configuration
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
